# NEIS Open API 설정
# https://open.neis.go.kr 에서 API 키 발급
NEIS_API_KEY=YOUR_NEIS_API_KEY_HERE

# 강원특별자치도교육청 코드
ATPT_OFCDC_SC_CODE=J10

# 원주고등학교 학교 코드 (NEIS에서 확인)
# https://open.neis.go.kr/hub/schoolInfo 에서 학교 코드 조회
SD_SCHUL_CODE=7530291

# Firebase 설정 (클라이언트 사이드 - 공개 가능)
# 이 값들은 js/firebase-config.js 에 직접 입력하거나 빌드 과정에서 주입
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
